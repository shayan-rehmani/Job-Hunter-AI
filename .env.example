# Copy this file to .env and configure your local environment.

# Application security
# Generate separate, long, random values for both secrets.
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
OTP_PEPPER=replace_with_a_separate_random_otp_secret

# Database
DATABASE_URL=sqlite:///./job_hunter.db

# Gmail SMTP configuration
# Use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_support_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_support_email@gmail.com

# OTP configuration
OTP_EXPIRE_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Production CORS configuration is not yet implemented in the current API.
# CORS_ORIGINS=http://localhost:5173
